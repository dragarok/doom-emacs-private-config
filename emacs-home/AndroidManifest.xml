<?xml version="1.0" encoding="utf-8"?>
<!-- Emacs as the home screen.  Shares com.termux's user (and so Emacs's):
     build.sh signs with the same key, so emacsclient's socket, Termux's
     home and QUERY_ALL_PACKAGES are all ours already. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="dev.alok.emacshome"
          android:sharedUserId="com.termux">

  <!-- The floating clock (FloatService).  The overlay and usage-stats
       app-ops are granted once over adb; see build.sh. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
  <!-- The island hears you itself (Hear.java): granted once over adb, see build.sh. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Only to switch the island's own accessibility service off and on when
       Android stops binding it after a restart (IslandAccess.heal); granted
       by build.sh install. -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

  <application android:label="Emacs Home">

    <service android:name=".FloatService" android:exported="false" />

    <!-- Reminders' alarms and their notification's buttons (Reminders.java). -->
    <receiver android:name=".ReminderReceiver" android:exported="false" />

    <!-- Lets the clock's island sit above the status bar; reads nothing. -->
    <service android:name=".IslandAccess"
             android:exported="true"
             android:label="Emacs Home clock island"
             android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice"
                 android:resource="@xml/island_access" />
    </service>

    <!-- The keyboard's microphone key: a voice-only input method that hands
         straight back and has the island listen (VoiceIme). -->
    <service android:name=".VoiceIme"
             android:exported="true"
             android:label="@string/voice_ime"
             android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/voice_ime" />
    </service>

    <!-- Home button: bring Emacs forward, tell it, refresh the app list. -->
    <activity android:name=".HomeActivity"
              android:exported="true"
              android:excludeFromRecents="true"
              android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- emacs-home://launch/PACKAGE/ACTIVITY, opened by `android-browse-url'. -->
    <activity android:name=".LaunchActivity"
              android:exported="true"
              android:excludeFromRecents="true"
              android:noHistory="true"
              android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="emacs-home" />
      </intent-filter>
    </activity>

    <!-- Listens once through the voice app and hands the words to Emacs.
         Not exported: only the island and Emacs's toolbar (voice-ask) start it.
         Not noHistory or NoDisplay, or the voice app's result never comes. -->
    <activity android:name=".VoiceActivity"
              android:exported="false"
              android:excludeFromRecents="true"
              android:taskAffinity=".voice"
              android:theme="@android:style/Theme.Translucent.NoTitleBar" />

  </application>
</manifest>

;;; android-launcher.el --- Toolbar buttons as home-screen widgets -*- lexical-binding: t -*-

;;; Commentary:
;; Puts the Emacs toolbar on the Android home screen.
;;
;; A tap on a Termux:Widget shortcut opens
;;   org-protocol://emacs-cmd?cmd=COMMAND
;; Android hands that link to Emacs's bundled emacsclient, which brings
;; Emacs to the front and runs COMMAND -- but only if COMMAND is a button
;; on `tool-bar-map'.  Any app or web page can open such a link, so the
;; toolbar is the allowlist; nothing else gets through.
;;
;; `android-launcher-generate' writes one shortcut per toolbar button into
;; ~/.shortcuts/tasks (background, no terminal flash), with its icon in
;; ~/.shortcuts/icons.  Re-run it whenever the toolbar changes.
;;
;; The emacsclient Android hands these links to looks for the server under
;; Emacs's own TMPDIR, so nothing may repoint TMPDIR before `server-start'.

;;; Code:

(require 'cl-lib)
(require 'url-util)
(require 'server)
(require 'org-protocol)
(require 'usage-log)

(defconst android-launcher-shortcuts-dir
  "/data/data/com.termux/files/home/.shortcuts/"
  "Termux:Widget's shortcut directory.
Emacs shares Termux's UID, so it can write here.")

(defconst android-launcher--marker "# generated by android-launcher"
  "Marks scripts this file wrote, so a re-run only removes its own.")

(defun android-launcher--buttons ()
  "Return (LABEL COMMAND SVG-FILE) for each command button on the toolbar.
Arrow keys and other lambda buttons are skipped: they mean nothing
outside Emacs."
  (let (buttons)
    (map-keymap
     (lambda (_key def)
       (when (and (eq (car-safe def) 'menu-item)
                  (symbolp (nth 2 def))
                  (commandp (nth 2 def)))
         (let ((image (plist-get (nthcdr 3 def) :image)))
           (push (list (nth 1 def) (nth 2 def)
                       (and image (plist-get (cdr image) :file)))
                 buttons))))
     (default-value 'tool-bar-map))
    (nreverse buttons)))

(defun android-launcher--handle (info)
  "Run the toolbar command named in INFO's :cmd, if it is on the toolbar."
  (let ((cmd (intern-soft (plist-get info :cmd))))
    (if (not (assq cmd (mapcar (lambda (b) (cons (nth 1 b) b))
                               (android-launcher--buttons))))
        (message "android-launcher: refusing %S (not a toolbar command)" cmd)
      ;; Off the server's process filter, so a command that prompts
      ;; doesn't leave the emacsclient connection hanging.
      (run-at-time 0 nil #'usage-log-call "widget" cmd)))
  ;; nil: there is no file for emacsclient to visit.
  nil)

(add-to-list 'org-protocol-protocol-alist
             '("emacs-cmd" :protocol "emacs-cmd"
               :function android-launcher--handle))

(defun android-launcher-generate ()
  "Write a Termux:Widget shortcut and icon for every toolbar button."
  (interactive)
  (let* ((tasks (expand-file-name "tasks/" android-launcher-shortcuts-dir))
         (icons (expand-file-name "icons/" android-launcher-shortcuts-dir))
         (rsvg (executable-find "rsvg-convert"))
         (seen (make-hash-table :test #'equal))
         (count 0))
    (make-directory tasks t)
    (make-directory icons t)
    (dolist (file (directory-files tasks t "^[^.]"))
      (when (with-temp-buffer
              (insert-file-contents file)
              (search-forward android-launcher--marker nil t))
        (delete-file file)
        (ignore-errors
          (delete-file (concat icons (file-name-nondirectory file) ".png")))))
    (pcase-dolist (`(,label ,cmd ,svg) (android-launcher--buttons))
      ;; Two buttons can share a label ("Add"); the second gets its command.
      (let ((name (if (gethash label seen) (format "%s (%s)" label cmd) label)))
        (puthash label t seen)
        (with-temp-file (concat tasks name)
          (insert "#!/data/data/com.termux/files/usr/bin/sh\n"
                  android-launcher--marker "\n"
                  (format "am start -a android.intent.action.VIEW -d 'org-protocol://emacs-cmd?cmd=%s' >/dev/null\n"
                          (url-hexify-string (symbol-name cmd)))))
        (set-file-modes (concat tasks name) #o700)
        (when (and rsvg svg (file-exists-p (expand-file-name svg)))
          (call-process rsvg nil nil nil "-w" "128" "-h" "128"
                        "-o" (concat icons name ".png")
                        (expand-file-name svg)))
        (cl-incf count)))
    (message "android-launcher: %d shortcuts%s" count
             (if rsvg "" " (no rsvg-convert: pkg install librsvg for icons)"))))

(unless (server-running-p)
  (server-start))

(provide 'android-launcher)
;;; android-launcher.el ends here
